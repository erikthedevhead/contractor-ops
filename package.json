{
  "name": "contractor-ops",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:migrate": "tsx --env-file=.env packages/db/src/migrate.ts",
    "tenant:create": "tsx --env-file=.env scripts/create-tenant.ts",
    "seed:sandbox": "tsx --env-file=.env scripts/seed-sandbox.ts",
    "sync:initial": "tsx --env-file=.env scripts/initial-sync.ts",
    "keygen": "tsx scripts/keygen.ts",
    "db:types": "tsx --env-file=.env scripts/gen-db-types.ts",
    "tenant:link": "tsx --env-file=.env scripts/create-tenant.ts --link",
    "dev": "tsx watch --env-file=.env apps/core/src/main.ts",
    "start": "node --env-file=.env --import tsx apps/core/src/main.ts",
    "reconcile": "tsx --env-file=.env scripts/reconcile.ts",
    "dlq": "tsx --env-file=.env scripts/dlq.ts",
    "webhooks:reingest": "tsx --env-file=.env scripts/reingest.ts",
    "api-key": "tsx --env-file=.env scripts/api-key.ts",
    "mcp:call": "tsx --env-file=.env scripts/mcp-call.ts",
    "chat": "tsx scripts/chat.ts",
    "dev:agent": "tsx watch --env-file=.env apps/office-manager/src/main.ts",
    "dev:estimator": "tsx watch --env-file=.env apps/estimator/src/main.ts",
    "eval": "tsx --env-file=.env evals/cli.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "@modelcontextprotocol/client": "^2.3.1"
  },
  "dependencies": {
    "@co/crypto": "workspace:*",
    "@co/db": "workspace:*",
    "@co/qbo": "workspace:*",
    "@co/shared": "workspace:*",
    "kysely": "^0.29.6",
    "@co/mcp": "workspace:*",
    "@co/worker": "workspace:*",
    "@co/agent": "workspace:*"
  }
}
