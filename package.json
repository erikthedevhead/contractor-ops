{
  "name": "contractor-ops",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:migrate": "tsx --env-file=.env packages/db/src/migrate.ts",
    "dev:api": "tsx watch --env-file=.env apps/api/src/server.ts",
    "tenant:create": "tsx --env-file=.env scripts/create-tenant.ts",
    "seed:sandbox": "tsx --env-file=.env scripts/seed-sandbox.ts",
    "sync:initial": "tsx --env-file=.env scripts/initial-sync.ts",
    "keygen": "tsx scripts/keygen.ts",
    "db:types": "tsx --env-file=.env scripts/gen-db-types.ts",
    "tenant:link": "tsx --env-file=.env scripts/create-tenant.ts --link"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@co/crypto": "workspace:*",
    "@co/db": "workspace:*",
    "@co/qbo": "workspace:*",
    "@co/shared": "workspace:*",
    "kysely": "^0.29.6"
  }
}
