# ---- runtime ----
NODE_ENV=development
# Local: 3000. Droplet: 3100 (nginx proxies to it).
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# ---- database ----
# App connects as the non-owner role so row-level security applies.
DATABASE_URL=postgresql://contractor_ops_app:CHANGE_ME@localhost:5432/contractor_ops
# Migrations run as the owner role.
MIGRATION_DATABASE_URL=postgresql://contractor_ops_owner:CHANGE_ME@localhost:5432/contractor_ops

# ---- secrets (generate with: pnpm keygen) ----
# JSON key ring: version -> base64 32-byte key. Rotate by adding "2" and bumping ACTIVE.
TOKEN_ENC_KEYS={"1":"CHANGE_ME"}
TOKEN_ENC_ACTIVE_VERSION=1
# Signs the one-time "connect QuickBooks" links printed by tenant:create.
CONNECT_LINK_SECRET=CHANGE_ME

# ---- QuickBooks (Intuit developer portal, Development keys) ----
QBO_ENV=sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/oauth/callback
# Day 2
QBO_WEBHOOK_VERIFIER=

# ---- Anthropic (Day 4) ----
ANTHROPIC_API_KEY=
